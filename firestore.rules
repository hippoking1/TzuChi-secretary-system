rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 取得使用者角色 helper
    function getUserRole() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role;
    }
    
    function isSuperAdmin() {
      return request.auth != null && getUserRole() == 'super_admin';
    }
    
    function isAdmin() {
      return request.auth != null && (getUserRole() == 'super_admin' || getUserRole() == 'admin');
    }
    
    function isConvener() {
      return request.auth != null && (getUserRole() == 'super_admin' || getUserRole() == 'admin' || getUserRole() == 'convener');
    }

    // 系統管理員帳號庫
    match /adminUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // 活動公開讀取，管理員/召集人可維護
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 報名紀錄：前台可建立/查詢，管理員可完全維護
    match /registrations/{regId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isConvener();
    }

    // 簽到紀錄：前台或管理員點名
    match /checkins/{checkinId} {
      allow read, create: if true;
      allow update, delete: if isConvener();
    }

    // 志工名單：前台核身比對需讀取，管理員維護
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 組織架構：公開讀取，管理員維護
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 會議列表：召集人可讀寫自己或所有會議
    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if isConvener();
      
      match /participants/{participantId} {
        allow read: if true;
        allow write: if isConvener();
      }
    }

    // 值班排程：公開查詢，管理員排班
    match /dutyShifts/{dutyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LINE 綁定：前台綁定/後台管理
    match /lineBindings/{bindingId} {
      allow read: if isConvener();
      allow write: if true;
    }

    // 操作日誌與系統設定
    match /logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
